{
  "name": "rolestash",
  "description": "Local-first Chrome extension that turns job postings into Kanban cards. No AI; optional accounts, sync and email updates.",
  "version": "0.4.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "build:e2e": "wxt build --mode e2e",
    "build:staging": "wxt build --mode staging",
    "build:web": "vite build --config web/vite.config.ts --mode staging",
    "build:web:e2e": "WEB_OUT=.output/web-e2e vite build --config web/vite.config.ts --mode e2e",
    "zip": "wxt zip",
    "postinstall": "wxt prepare",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:workflows": "docker run --rm -v \"$PWD:/repo\" -w /repo rhysd/actionlint@sha256:b1934ee5f1c509618f2508e6eb47ee0d3520686341fec936f3b79331f9315667 -no-color",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build:e2e && npm run build:web:e2e && playwright test --project=e2e --project=web",
    "docs:sites": "tsx scripts/generate-supported-sites.ts",
    "site:chrome": "tsx scripts/build-site-chrome.ts",
    "site:og": "tsx scripts/site-og-image.ts",
    "site:screenshots": "npm run build:e2e && tsx scripts/site-screenshots.ts",
    "store:screenshots": "npm run build && tsx scripts/store-screenshots.ts",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build && npm run build:web",
    "test:smoke": "npm run build && playwright test --project=smoke",
    "perf:board": "npm run build && playwright test --project=perf --reporter=list",
    "release": "node scripts/changelog.ts release",
    "test:db": "supabase db start && supabase db reset --local && supabase test db && supabase db lint --local --level warning --fail-on warning",
    "db:stop": "supabase stop"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/inter": "^5.3.0",
    "clsx": "^2.1.1",
    "fflate": "0.8.3",
    "lucide-react": "^1.48.0",
    "pdfjs-dist": "6.3.289",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.2",
    "@wxt-dev/module-react": "^1.2.2",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.5",
    "postal-mime": "4.0.2",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "supabase": "^2.118.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2",
    "wxt": "^0.21.4"
  }
}
