# E2E builds (npm run build:e2e) talk to the mock backend in tests/e2e/mock-backend.ts.
# Public test values only; production builds get theirs from CI settings.
WXT_SUPABASE_URL=http://127.0.0.1:54399
WXT_SUPABASE_ANON_KEY=e2e-anon-key

# Fake Google client so the E2E build offers the Google button.
WXT_GOOGLE_CLIENT_ID=e2e-client.apps.googleusercontent.com
