/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; base-uri 'none'; form-action 'self' https://fhclnxqumcdsqxyunelp.supabase.co/functions/v1/launch-list; frame-ancestors 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=(), browsing-topics=()
  Cross-Origin-Opener-Policy: same-origin

/assets/*
  Cache-Control: public, max-age=86400

# Checkout and pricing are the only pages that load Paddle.js. Detach the
# site-wide CSP (two CSP headers would both apply) and allow exactly Paddle's origins.
/pay/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'none'; script-src 'self' https://cdn.paddle.com; style-src 'self' 'unsafe-inline' https://cdn.paddle.com https://sandbox-cdn.paddle.com; img-src 'self' data: https://*.paddle.com; font-src 'self' https://cdn.paddle.com https://sandbox-cdn.paddle.com; frame-src https://buy.paddle.com https://sandbox-buy.paddle.com; connect-src https://*.paddle.com; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests

# Pricing: same Paddle CSP.
/pricing/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'none'; script-src 'self' https://cdn.paddle.com; style-src 'self' 'unsafe-inline' https://cdn.paddle.com https://sandbox-cdn.paddle.com; img-src 'self' data: https://*.paddle.com; font-src 'self' https://cdn.paddle.com https://sandbox-cdn.paddle.com; frame-src https://buy.paddle.com https://sandbox-buy.paddle.com; connect-src https://*.paddle.com; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests

# Google sign-in hand-off (ADR-0012): only our own script, no referrer, and
# never cached, because the page runs on a URL fragment carrying an ID token.
/auth/*
  ! Content-Security-Policy
  ! Referrer-Policy
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests
  Referrer-Policy: no-referrer
  Cache-Control: no-store

# The web board (ADR-0017): a built app at /board/, signed in with Supabase.
# Own scripts only, and network access only to our Supabase project.
/board/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src https://fhclnxqumcdsqxyunelp.supabase.co; manifest-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests

/board/
  Cache-Control: no-cache

/board/index.html
  Cache-Control: no-cache

/board/assets/*
  Cache-Control: public, max-age=31536000, immutable
